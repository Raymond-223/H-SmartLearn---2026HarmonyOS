# Safe local development defaults. Put private provider keys in your own untracked .env.
DATABASE_URL=sqlite+aiosqlite:///./smartlearn.db
DATABASE_URL_SYNC=sqlite:///./smartlearn.db

# disabled: deterministic offline fallback; openai: server-side Responses API provider.
LLM_PROVIDER=disabled
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=

# Required when DEBUG=false; protects /api/v1/admin/*.
ADMIN_API_KEY=
MAX_UPLOAD_BYTES=10485760
# Comma-separated browser origins for production. Native HarmonyOS requests do not require CORS.
CORS_ORIGINS=

APP_NAME=H-SmartLearn Platform
APP_VERSION=1.7.3
DEBUG=true
WORKFLOW_STEP_DELAY_SECONDS=0
