{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "procedure.schema.json",
  "title": "Procedure",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "skill_id",
    "title",
    "ros_version",
    "prerequisites",
    "steps",
    "expected_output",
    "failure_cases",
    "rollback",
    "risk_level",
    "evidence_ids",
    "validator_ids",
    "execution_verification_status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "skill_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "ros_version": {
      "type": "string"
    },
    "prerequisites": {
      "type": "array"
    },
    "steps": {
      "type": "array",
      "minItems": 1
    },
    "expected_output": {
      "type": "string"
    },
    "failure_cases": {
      "type": "array",
      "minItems": 1
    },
    "rollback": {
      "type": "array",
      "minItems": 1
    },
    "risk_level": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1
    },
    "validator_ids": {
      "type": "array",
      "minItems": 1
    },
    "execution_verification_status": {
      "enum": [
        "not_run",
        "passed",
        "failed",
        "partial"
      ]
    },
    "applicability": {
      "type": "object"
    }
  }
}
