{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assessment_item.schema.json",
  "title": "AssessmentItem",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "skill_id",
    "type",
    "difficulty",
    "stem",
    "options",
    "correct_answer",
    "explanation",
    "estimated_seconds",
    "evidence_ids"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "skill_id": {
      "type": "string"
    },
    "type": {
      "enum": [
        "single_choice",
        "multiple_choice",
        "short_answer",
        "debugging"
      ]
    },
    "difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "stem": {
      "type": "string",
      "minLength": 5
    },
    "options": {
      "type": "array"
    },
    "correct_answer": {},
    "explanation": {
      "type": "string"
    },
    "estimated_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "discrimination": {
      "type": [
        "number",
        "null"
      ]
    }
  }
}
